# PostgreSQL URI (Neon, Supabase, or another managed PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# Optional. Omit to respect the PostgreSQL URI; `require` enables TLS validation.
# Set disable only for local PostgreSQL without TLS.
DATABASE_SSL=require
# Generate with: openssl rand -base64 32 (must decode to exactly 32 bytes)
APP_SECRET=replace_with_base64_32_byte_key
# Generate a different random string for session cookie signing
SESSION_SECRET=replace_with_random_secret
ADMIN_PASSWORD=replace_with_a_strong_admin_password
# Random bearer token sent by the scheduler endpoint
CRON_SECRET=replace_with_a_random_scheduler_token
